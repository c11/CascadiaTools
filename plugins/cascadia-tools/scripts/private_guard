#!/bin/bash
# CascadiaTools data-private guard (PreToolUse hook). Exits at once unless this project has turned
# on private mode, so normal sessions pay nothing and never start R. Private mode runs the check in
# R, which every CascadiaTools user has; if R can't run the check, the tool call is refused.
proj="${CLAUDE_PROJECT_DIR:-$PWD}"
[[ -f "$proj/.cascadia/private.json" ]] || exit 0
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CLAUDE_PROJECT_DIR="$proj"
if out="$(bash "$here/Rscript" "$here/private_guard.R")"; then
  [[ -n "$out" ]] && printf '%s\n' "$out"
  exit 0
fi
printf '%s\n' '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": "Data-private mode is on, but its guard failed. Check the guard error, R/jsonlite availability, the tool event and .cascadia/private.json. Tool calls are refused until this is fixed. Do not remove private mode unless the user explicitly requests it."}}'
exit 0
